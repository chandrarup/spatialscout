# Secrets: never commit. Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example
*.env.txt

# Raw and probe data: large, licensed by their sources, re-downloadable. Never committed.
# Anchored to the repo root so the `src/spatialscout/data/` package stays tracked.
/data/

# Investigation runs (audit logs, packages) written by a local server
/var/

# Git worktrees created by agent sessions
/.claude/worktrees/

# Tooling and build output
.playwright-mcp/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
node_modules/
dist/
build/
*.egg-info/
.cache/
.DS_Store
*.log

# Spike outputs (regenerable)
spikes/out/

# Agent worktrees live inside the repo folder; never commit them
.claude/worktrees/
